# VeggieLife CV Service Environment Variables Template

# Inference Mode: 'roboflow' or 'local'
INFERENCE_MODE=roboflow

# Roboflow Serverless Cloud API Settings
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PROJECT_ID=smart-fridge-co7ul-v7nkj
ROBOFLOW_MODEL_ID=smart-fridge-co7ul-v7nkj/1
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Confidence & Thresholds
DEFAULT_CONF_THRESHOLD=0.40
DEFAULT_IOU_THRESHOLD=0.45

# Server Port
PORT=8080
